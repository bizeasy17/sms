    },
    {
      "version": "CN-1.0",
      "date": "2026-03-23",
      "change": "Planned enhancement logged: integrate SW daily historical quantile anchors (3Y/5Y/10Y) from Tushare Pro sw_daily into industry valuation target generation (PE/PB, optionally PS), blended with current cross-sectional metrics and global defaults with bounded constraints."
    },
    {
      "version": "CN-1.0",
      "date": "2026-03-23",
      "change": "Implemented MVP: integrated SW daily historical quantile anchors (3Y/5Y/10Y) into syncswvaluation parameter generation via a decoupled SwHistoryQuantileService. PE/PB targets now blend cross-sectional target, history anchor and global baseline under bounded constraints, and output includes history_quantiles/history_anchors metadata and target_source."
    },
    {
      "version": "CN-1.0",
      "date": "2026-03-23",
      "change": "Enabled standalone valuation sw_history persistence with explicit valuation_variant signatures (hist_y<years>_q<quantile>_m<min_samples>) and row-level variant precedence, so historical PE/PB/PS component rows can coexist with default PE/PB/PS snapshots."
    }
