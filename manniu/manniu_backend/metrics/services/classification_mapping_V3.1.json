{
  "_meta": {
    "version": "4.0",
    "created": "2026-07-03",
    "description": "股票风格分类配置 — V4 三项专项优化版",
    "changelog": [
      "v3.0 vs v1.0: 关键词分层 strong/weak，新增 exclude_industry/exclude_business 排除机制",
      "v3.0 vs v1.0: heavy_manufacturing 排除软件/互联网/广告/教育行业，消除'设备/制造/工业'泛化污染",
      "v3.0 vs v1.0: growth_tech 移除宽泛的'电子''医疗器械'行业词，新增 unique_keywords 强信号词",
      "v3.0 vs v1.0: fallback 默认目标从 growth_tech 改为 stable_consumer，并增加行业映射表",
      "v3.0 vs v1.0: 噪声词降级后优先选 top2，而非硬编码 growth_tech",
      "v3.0 vs v1.0: generic_term_score_multipliers 大幅降权 (设备 0.55→0.25, 制造 0.65→0.35, 工业 0.60→0.25, 研发 新增 0.30)",
      "v3.0 vs v1.0: stable_income 补充新型电力/水力发电/火力发电/新能源运营等行业",
      "v3.0 vs v1.0: stable_consumer 补充百货/超市/旅游/酒店/服饰/中药/化学制药等行业",
      "v3.0 vs v1.0: platform_service 补充广告包装/文教休闲/出版/影视/教育等行业",
      "v3.0 vs v1.0: cyclical_resource 补充石油加工/化纤/橡胶/染料/水泥/陶瓷等行业",
      "v3.0 vs v1.0: 新增 conflict_resolution 冲突解决规则，处理 top1/top2 分数接近时的行业交叉验证",
      "v3.0 vs v1.0: 新增 noise_word_downgrade_policy，降级后选 top2 而非硬编码",
      "v4.0 fix①: 完善 industry_fallback_map，补充 heavy_manufacturing/growth_tech/stable_income 等40+行业精确映射，减少 fallback 到默认值",
      "v4.0 fix②: heavy_manufacturing 新增 unique_keywords 保护层（整车制造/工程机械/船舶建造等），growth_tech weak词移除'模块'，新增 conflict_resolution 规则防止传统制造行业误入 growth_tech",
      "v4.0 fix③: growth_tech 新增电池材料全系列 industry/business/bz/unique_keywords，cyclical_resource 新增 exclude_industry/exclude_business 排除电池材料，新增冲突规则防止电池材料误入 cyclical_resource"
    ]
  },
  "style_priority": [
    "finance_realestate",
    "stable_income",
    "cyclical_resource",
    "platform_service",
    "heavy_manufacturing",
    "stable_consumer",
    "growth_tech"
  ],
  "matching_rules": {
    "_comment": "分类判断规则参数",
    "minimum_strong_matches_for_valid": 1,
    "weak_keyword_min_count_to_score": 3,
    "weak_keyword_requires_industry_match": true,
    "score_gap_confident_threshold": 15,
    "score_gap_ambiguous_threshold": 10,
    "confidence_thresholds": {
      "high": 85,
      "medium": 70,
      "low": 50
    }
  },
  "source_weights": {
    "_comment": "各来源字段的基础权重",
    "industry": 3.0,
    "business_strong": 2.5,
    "business_weak": 0.8,
    "bz_strong": 2.2,
    "bz_weak": 0.6
  },
  "generic_term_score_multipliers": {
    "_comment": "通用词汇降权系数 — 防止 heavy_manufacturing 成为垃圾筐。这些词在多个行业普遍出现，单独命中不应给高分",
    "设备": 0.25,
    "制造": 0.35,
    "工业": 0.25,
    "零售": 0.65,
    "工程": 0.55,
    "研发": 0.3,
    "服务": 0.35,
    "运营": 0.4,
    "产品": 0.3,
    "业务": 0.25
  },
  "noise_word_downgrade_policy": {
    "_comment": "当 top1 被噪声词降级时的处理策略",
    "prefer_top2_over_hardcode": true,
    "top2_min_score_to_use": 60,
    "hardcode_fallback_if_no_top2": "stable_consumer",
    "noise_patterns": [
      {
        "trigger_style": "finance_realestate",
        "trigger_industries": [
          "元器件",
          "半导体",
          "电子",
          "通信设备",
          "光模块",
          "软件服务",
          "互联网",
          "IT设备",
          "IT服务"
        ],
        "action": "downgrade_to_top2_or_growth_tech"
      },
      {
        "trigger_style": "stable_income",
        "trigger_industries": [
          "电气设备",
          "专用机械",
          "汽车配件",
          "船舶",
          "军工",
          "通信设备"
        ],
        "action": "downgrade_to_top2_or_heavy_manufacturing"
      }
    ]
  },
