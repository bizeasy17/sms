# Windows (任务计划程序，命令行示例) dummy
> py manage.py setup # 仅运行一次以设置环境, 
> py manage.py download --freq=D --dtype=TRADING # 每天运行一次
> py manage.py download --dtype=FUNDAMENTAL # 每天运行一次
> py manage.py resample --dtype=TRADING --freq=W  # 每周运行一次
> py manage.py resample --dtype=TRADING --freq=M  # 每月运行一次
> py manage.py resample --dtype=FUNDAMENTAL --freq=W # 每周运行一次
> py manage.py resample --dtype=FUNDAMENTAL --freq=M # 每月运行一次
> py manage.py fetchcorp # 每月运行一次
